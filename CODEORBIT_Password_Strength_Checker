def check_password_strength(password):
    score = 0
    feedback = []

    if len(password) >= 8:
        score += 1
    else:
        feedback.append("- Make it at least 8 characters long.")
    if any(char.isupper() for char in password):
        score += 1
    else:
        feedback.append("- Add at least one uppercase letter (A-Z).")

    if any(char.islower() for char in password):
        score += 1
    else:
        feedback.append("- Add at least one lowercase letter (a-z).")

    if any(char.isdigit() for char in password):
        score += 1
    else:
        feedback.append("- Add at least one number (0-9).")

    special_characters = "!@#$%^&*()-_=+[{]};:'\",<.>/?\\|`~"
    if any(char in special_characters for char in password):
        score += 1
    else:
        feedback.append("- Add at least one special character (e.g., !, @, #, $).")

    print("\n--- Password Analysis ---")
    if score == 5:
        print("Status: STRONG PASSWORD")
        print("Great job! Your password meets all security criteria.")
    elif score >= 3:
        print("Status: MODERATE PASSWORD")
        print("Suggestions to improve:")
        for item in feedback:
            print(item)
    else:
        print("Status: WEAK PASSWORD")
        print("Suggestions to improve:")
        for item in feedback:
            print(item)


if __name__ == "__main__":
    user_password = input("Enter a password to test: ")
    check_password_strength(user_password)
